<%- include('partials/top') %>
<% const diamond = '<div class="rule" aria-hidden="true"><svg viewBox="0 0 12 12"><path d="M6 0l6 6-6 6-6-6z"/></svg></div>'; %>
<section class="page-head">
  <div class="wrap narrow">
    <h1><%= page.h1.charAt(0).toUpperCase() + page.h1.slice(1) %></h1>
    <p><%= page.intro %></p>
    <ul class="ticks" style="max-width:560px;margin:22px auto 0;text-align:left"><% page.points.forEach((pt) => { %><li><%= pt %></li><% }) %></ul>
    <div class="rsvp-actions"><a class="btn btn-verm" href="/products?category=<%= page.category %>">Order in bulk</a><a class="btn btn-foil" href="/delivery">Check delivery to you</a></div>
  </div>
</section>

<section class="wrap" aria-labelledby="range-h" style="padding-top:24px">
  <div class="section-head"><h2 id="range-h" class="h-sub" style="margin:0">Wholesale range &amp; prices</h2><a class="link-more" href="/products?category=<%= page.category %>">Filter the full range</a></div>
  <div class="places"><% products.forEach((p) => { %><%- include('partials/card', { p }) %><% }) %></div>
</section>

<section class="band sunk" aria-labelledby="why-h">
  <div class="wrap">
    <div class="band-head"><h2 id="why-h">Why <%= site.city %> businesses order from <%= site.brand %></h2><%- diamond %></div>
    <ol class="programme">
      <li><span class="when">Cold chain</span><div><h3>Delivered frozen</h3><p>Our own reefer fleet at −18°C with data loggers; no third-party couriers.</p></div></li>
      <li><span class="when">Pricing</span><div><h3>Clear bulk tiers</h3><p>Tier prices on every product, GST invoices, and credit terms for registered businesses.</p></div></li>
      <li><span class="when">Coverage</span><div><h3>Across both Telugu states</h3><p>Same day in <%= site.serviceZones[0].areas.slice(0, 4).join(', ') %>, and scheduled reefer routes to every region of Telangana and Andhra Pradesh. <a href="/delivery">See the map</a>.</p></div></li>
    </ol>
  </div>
</section>
<%- include('partials/bottom') %>
