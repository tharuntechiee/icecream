<%- include('partials/top') %>
<section class="hero hero-compact">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow"><%= site.brand %> · <%= site.city %></p>
      <h1><%= page.h1.charAt(0).toUpperCase() + page.h1.slice(1) %></h1>
      <p class="lead"><%= page.intro %></p>
      <ul class="ticks"><% page.points.forEach((pt) => { %><li><%= pt %></li><% }) %></ul>
      <div class="hero-ctas">
        <a class="btn btn-primary" href="/quote">Get a bulk quote</a>
        <a class="btn btn-secondary" href="/products?category=<%= page.category %>">Browse range</a>
      </div>
    </div>
    <% const c = content.categories.find((x) => x.id === page.category); %>
    <div class="hero-art single" aria-hidden="true"><img src="<%= h.shapeUrl(c.art) %>" alt="" width="400" height="300"></div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-head"><h2>Wholesale range &amp; prices</h2><a class="link-more" href="/products?category=<%= page.category %>">Filter the full range →</a></div>
    <div class="grid grid-cards">
      <% products.forEach((p) => { %><%- include('partials/card', { p }) %><% }) %>
    </div>
  </div>
</section>

<section class="section section-soft">
  <div class="container">
    <div class="section-head"><h2>Why <%= site.city %> businesses order from <%= site.brand %></h2></div>
    <div class="grid grid-3">
      <div class="card"><h3>Delivered frozen</h3><p class="muted">Own reefer fleet at −18°C with data loggers — no third-party couriers.</p></div>
      <div class="card"><h3>Clear bulk pricing</h3><p class="muted">Tier prices on every product, GST invoices and credit terms for registered businesses.</p></div>
      <div class="card"><h3>Across the city</h3><p class="muted">Same-day in <%= site.serviceZones[0].areas.slice(0, 4).join(', ') %> and more. <a href="/delivery">See all areas</a>.</p></div>
    </div>
  </div>
</section>
<%- include('partials/bottom') %>
