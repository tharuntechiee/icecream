<%
  const m = locals.meta || {};
  const canonical = site.siteUrl + (m.canonical || path);
  const ogImage = site.siteUrl + (m.image || '/art/s/tub.svg?c=F2B66D&l=BULK');
  const navLinks = [
    ['/products', 'Catalogue'], ['/events', 'Events & catering'], ['/custom-packaging', 'Custom packs'],
    ['/delivery', 'Delivery'], ['/about', 'About'], ['/faq', 'FAQ'], ['/contact', 'Contact'],
  ];
  const isActive = (href) => path === href || path.startsWith(href + '/');
%><!doctype html>
<html lang="en-IN" data-theme="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title><%= m.title || site.brand %></title>
  <meta name="description" content="<%= m.description || site.tagline %>">
  <% if (m.noindex) { %><meta name="robots" content="noindex, nofollow"><% } else { %><link rel="canonical" href="<%= canonical %>"><% } %>
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="<%= site.brand %>">
  <meta property="og:title" content="<%= m.title || site.brand %>">
  <meta property="og:description" content="<%= m.description || site.tagline %>">
  <meta property="og:url" content="<%= canonical %>">
  <meta property="og:image" content="<%= ogImage %>">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="theme-color" content="#10173a">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="preload" href="/fonts/yatra-400.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/hind-400.woff2" as="font" type="font/woff2" crossorigin>
  <script>try{var q=new URLSearchParams(location.search).get('theme'),t=q||JSON.parse(localStorage.getItem('siteTheme')||'null');if(t==='light'||t==='dark')document.documentElement.dataset.theme=t}catch(e){}</script>
  <link rel="stylesheet" href="/css/styles.css">
  <% if (!locals.admin) { %>
  <script type="application/ld+json"><%- h.jsonScript({
    '@context': 'https://schema.org', '@type': 'WholesaleStore', name: site.brand, legalName: site.legalName,
    url: site.siteUrl, telephone: site.phone, email: site.email, priceRange: '₹₹',
    image: site.siteUrl + '/art/s/tub.svg',
    address: { '@type': 'PostalAddress', streetAddress: site.address.line1, addressLocality: site.address.city, addressRegion: site.address.region, postalCode: site.address.postcode, addressCountry: 'IN' },
    areaServed: [site.city, ...site.otherCities],
    openingHours: ['Mo-Sa 07:00-21:00', 'Su 08:00-14:00'],
  }) %></script>
  <% } %>
</head>
<body class="<%= locals.admin ? 'is-admin' : '' %>">
<a class="skip" href="#main">Skip to content</a>
<% if (!locals.admin) { %>
<header class="site-head">
  <div class="wrap head-in">
    <a class="brand" href="/" aria-label="<%= site.brand %> home"><%= site.brand %></a>
    <nav class="nav" id="nav" aria-label="Main">
      <% navLinks.forEach(([href, label]) => { %><a href="<%= href %>"<%- isActive(href) ? ' aria-current="page"' : '' %>><%= label %></a>
      <% }) %><a class="drawer-only" href="/register">Business account</a>
    </nav>
    <div class="head-tools">
      <button class="icon-btn" type="button" data-theme-toggle aria-label="Switch to light theme">
        <svg class="ico theme-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg>
        <svg class="ico theme-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
      <a class="quote-link" href="/quote">Quote <b data-cart-count hidden>0</b></a>
      <button class="icon-btn menu-btn" type="button" aria-controls="nav" aria-expanded="false" aria-label="Open menu">
        <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </div>
</header>
<% } %>
<main id="main">
