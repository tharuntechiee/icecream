<%
  const m = locals.meta || {};
  const canonical = site.siteUrl + (m.canonical || path);
  const ogImage = site.siteUrl + (m.image || '/art/s/tub.svg?c=F4A3B4&l=BULK');
  const navLinks = [
    ['/products', 'Products'], ['/custom-packaging', 'Custom Packaging'], ['/events', 'Events & Catering'],
    ['/delivery', 'Delivery'], ['/about', 'About'], ['/faq', 'FAQ'], ['/contact', 'Contact'],
  ];
  const isActive = (href) => path === href || (href !== '/' && path.startsWith(href + '/'));
%><!doctype html>
<html lang="en-IN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title><%= m.title || site.brand %></title>
  <meta name="description" content="<%= m.description || site.tagline %>">
  <% if (m.noindex) { %><meta name="robots" content="noindex, nofollow"><% } else { %><link rel="canonical" href="<%= canonical %>"><% } %>
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="<%= site.brand %>">
  <meta property="og:title" content="<%= m.title || site.brand %>">
  <meta property="og:description" content="<%= m.description || site.tagline %>">
  <meta property="og:url" content="<%= canonical %>">
  <meta property="og:image" content="<%= ogImage %>">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="theme-color" content="#ff385c">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css">
  <% if (!locals.admin) { %>
  <script type="application/ld+json"><%- h.jsonScript({
    '@context': 'https://schema.org', '@type': 'WholesaleStore', name: site.brand, legalName: site.legalName,
    url: site.siteUrl, telephone: site.phone, email: site.email, priceRange: '₹₹',
    image: site.siteUrl + '/art/s/tub.svg',
    address: { '@type': 'PostalAddress', streetAddress: site.address.line1, addressLocality: site.address.city, addressRegion: site.address.region, postalCode: site.address.postcode, addressCountry: 'IN' },
    areaServed: [site.city, ...site.otherCities],
    openingHours: ['Mo-Sa 07:00-21:00', 'Su 08:00-14:00'],
  }) %></script>
  <% } %>
</head>
<body class="<%= locals.admin ? 'is-admin' : '' %>">
<a class="skip-link" href="#main">Skip to content</a>
<% if (!locals.admin) { %>
<div class="topbar">
  <div class="container topbar-inner">
    <span>❄ Wholesale only · Minimum order <%= h.money(site.minOrderValue) %> · Delivered at −18°C</span>
    <span class="topbar-links"><a href="tel:<%= site.phone.replace(/\s/g, '') %>"><%= site.phone %></a><a href="/register">Business account</a></span>
  </div>
</div>
<header class="site-header">
  <div class="container header-inner">
    <a class="logo" href="/" aria-label="<%= site.brand %> home">
      <svg width="30" height="30" viewBox="0 0 32 32" aria-hidden="true"><path d="M9 14a7 7 0 0 1 14 0z" fill="#ff385c"/><path d="M8 14h16l-8 15z" fill="#E3A857"/><path d="M11 17l5 7m0-7l-5 7m10-7l-5 7" stroke="#B9813F" stroke-width="1.2"/></svg>
      <span><%= site.brand %></span>
    </a>
    <nav class="main-nav" id="main-nav" aria-label="Main">
      <% navLinks.forEach(([href, label]) => { %>
        <a href="<%= href %>" class="<%= isActive(href) ? 'active' : '' %>"><%= label %></a>
      <% }) %>
      <a href="/register" class="nav-mobile-only">Register business account</a>
    </nav>
    <div class="header-actions">
      <a class="btn btn-primary btn-sm quote-btn" href="/quote" aria-label="Open quote cart">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 11h6M9 15h4M7 3h10a2 2 0 0 1 2 2v16l-3-2-2 2-2-2-2 2-2-2-3 2V5a2 2 0 0 1 2-2z"/></svg>
        <span class="quote-btn-label">Quote</span>
        <span class="badge-count" data-cart-count hidden>0</span>
      </a>
      <button class="menu-toggle" type="button" aria-controls="main-nav" aria-expanded="false" aria-label="Open menu">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </div>
</header>
<% } %>
<main id="main">
