<%
  const s = h.defaultSize(p);
  const seal = p.category === 'custom' ? 'Made to order' : p.seasonal ? 'Seasonal' : p.featured ? 'Bestseller' : '';
  const diet = p.dietary.filter((d) => d !== 'eggless').map((d) => content.dietary[d]).join(' · ');
  const packs = [...new Set(p.sizes.map((x) => x.packSize))].join(' · ');
%>
<article class="place">
  <% if (seal) { %><span class="seal"><%= seal %></span><% } %>
  <h3><a href="/products/<%= p.id %>"><%= p.name %></a></h3>
  <% if (p.flavours.length) { %>
  <div class="swatches" aria-label="Flavours: <%= p.flavours.join(', ') %>">
    <% p.flavours.forEach((f) => { %><span class="sw" style="background:<%= h.swatch(f) %>" title="<%= f %>"></span><% }) %>
  </div>
  <% } %>
  <dl class="specs">
    <dt>Pack</dt><dd><%= packs %></dd>
    <dt>Per <%= s.unit %></dt><dd><%= s.contains %></dd>
    <dt>Minimum</dt><dd><%= s.moq %> <%= s.moq === 1 ? s.unit : (s.unit === 'box' ? 'boxes' : s.unit + 's') %></dd>
    <% if (diet) { %><dt>Diet</dt><dd><%= diet %></dd><% } %>
  </dl>
  <div class="place-foot">
    <span class="price"><%= h.money(h.fromPrice(p)) %> <small>/ <%= s.unit %>, best tier</small></span>
    <button class="btn btn-foil btn-sm" type="button" data-add-to-quote data-name="<%= p.name %>" data-product="<%= p.id %>" data-size="<%= s.id %>" data-qty="<%= s.moq %>" data-flavour="<%= p.flavours.length > 1 ? 'Assorted' : (p.flavours[0] || '') %>">Add to cart</button>
  </div>
</article>
