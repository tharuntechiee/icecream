</main>
<% if (!locals.admin) { %>
<footer class="site-foot">
  <div class="wrap">
    <div class="foot-grid">
      <div>
        <p class="brand"><%= site.brand %></p>
        <p>Bulk ice cream, custom-branded packs, ice and event setups for <%= site.city %>. Wholesale orders only. A person confirms every quote; no online payment.</p>
        <p class="small mute">FSSAI Lic. No. <%= site.certifications.fssai %> · GSTIN <%= site.certifications.gstin %></p>
      </div>
      <div>
        <p class="label">Order</p>
        <% content.categories.forEach((c) => { %><a href="/products?category=<%= c.id %>"><%= c.name %></a><% }) %>
        <a href="/events">Event packages</a><a href="/quote">Quote cart</a>
      </div>
      <div>
        <p class="label">Help</p>
        <a href="/delivery">Delivery areas</a><a href="/faq">FAQ</a><a href="/register">Business account</a>
        <% Object.entries(content.landings).forEach(([slug, l]) => { %><a href="/<%= slug %>"><%= l.h1.charAt(0).toUpperCase() + l.h1.slice(1) %></a><% }) %>
      </div>
      <div>
        <p class="label">RSVP</p>
        <a href="tel:<%= site.phone.replace(/\s/g, '') %>"><%= site.phone %></a>
        <a href="<%= h.waLink(`Hi ${site.brand}!`) %>" target="_blank" rel="noopener">WhatsApp</a>
        <a href="mailto:<%= site.email %>"><%= site.email %></a>
        <span class="small mute" style="display:block;padding-top:6px"><%= site.address.line1 %>, <%= site.address.city %> <%= site.address.postcode %></span>
        <% site.hours.forEach((hr) => { %><span class="small mute" style="display:block"><%= hr.days %>: <%= hr.time %></span><% }) %>
      </div>
    </div>
    <div class="foot-note"><span>© <%= year %> <%= site.legalName %> · Prices exclude GST</span><span>Demo site: brand, contacts, testimonials and client names are illustrative placeholders.</span></div>
  </div>
</footer>

<div class="float">
  <a class="fab-wa" href="<%= h.waLink(`Hi ${site.brand}, I'd like a bulk quote.`) %>" target="_blank" rel="noopener" aria-label="Chat on WhatsApp">
    <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M16 3a13 13 0 0 0-11.2 19.6L3 29l6.6-1.7A13 13 0 1 0 16 3zm0 23.7a10.7 10.7 0 0 1-5.5-1.5l-.4-.2-3.9 1 1-3.8-.3-.4A10.7 10.7 0 1 1 16 26.7zm5.9-8c-.3-.2-1.9-.9-2.2-1s-.5-.2-.7.2-.8 1-1 1.2-.4.2-.7 0a8.8 8.8 0 0 1-4.3-3.8c-.3-.6.3-.5 1-1.7a.6.6 0 0 0 0-.6l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6a1.2 1.2 0 0 0-.9.4 3.6 3.6 0 0 0-1.1 2.7 6.3 6.3 0 0 0 1.3 3.3 14.4 14.4 0 0 0 5.5 4.9c2 .9 2.9 1 3.9.8a3.3 3.3 0 0 0 2.2-1.5 2.7 2.7 0 0 0 .2-1.5c-.1-.2-.3-.3-.6-.5z"/></svg>
  </a>
  <% if (path !== '/quote') { %>
  <a class="fab-quote" href="/quote">
    <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
    Get bulk quote
  </a>
  <% } %>
</div>
<div class="toast" role="status" aria-live="polite" hidden></div>
<% } %>
<script src="/js/pricing.js"></script>
<script src="/js/app.js"></script>
<% if (locals.scripts) { locals.scripts.forEach((s) => { %><script src="<%= s %>"></script><% }) } %>
</body>
</html>
