</main>
<% if (!locals.admin) { %>
<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a class="logo" href="/"><span><%= site.brand %></span></a>
      <p class="muted">Bulk ice cream, custom-branded packs and ice for businesses and events in <%= site.city %>. Wholesale orders only.</p>
      <p class="muted small">FSSAI Lic. No. <%= site.certifications.fssai %><br>GSTIN <%= site.certifications.gstin %></p>
    </div>
    <div>
      <h3 class="footer-head">Products</h3>
      <% content.categories.forEach((c) => { %><a href="/products?category=<%= c.id %>"><%= c.name %></a><% }) %>
      <a href="/events">Event packages</a>
    </div>
    <div>
      <h3 class="footer-head">Ordering</h3>
      <a href="/quote">Quote cart</a><a href="/register">Business account</a><a href="/delivery">Delivery areas</a><a href="/faq">FAQ</a>
    </div>
    <div>
      <h3 class="footer-head">Popular in <%= site.city %></h3>
      <% Object.entries(content.landings).forEach(([slug, l]) => { %><a href="/<%= slug %>"><%= l.h1.charAt(0).toUpperCase() + l.h1.slice(1) %></a><% }) %>
    </div>
    <div>
      <h3 class="footer-head">Contact</h3>
      <a href="tel:<%= site.phone.replace(/\s/g, '') %>"><%= site.phone %></a>
      <a href="mailto:<%= site.email %>"><%= site.email %></a>
      <span class="muted small"><%= site.address.line1 %>, <%= site.address.city %> <%= site.address.postcode %></span>
      <% site.hours.forEach((hr) => { %><span class="muted small"><%= hr.days %>: <%= hr.time %></span><% }) %>
    </div>
  </div>
  <div class="container legal-band">
    <span>© <%= year %> <%= site.legalName %></span>
    <span>Prices exclusive of GST · No online payments — every order is confirmed by our team</span>
  </div>
</footer>

<div class="floating-actions" aria-label="Quick actions">
  <a class="fab-wa" href="<%= h.waLink(`Hi ${site.brand}, I'd like a bulk quote.`) %>" target="_blank" rel="noopener" aria-label="Chat on WhatsApp">
    <svg width="26" height="26" viewBox="0 0 32 32" aria-hidden="true"><path fill="#fff" d="M16 3a13 13 0 0 0-11.2 19.6L3 29l6.6-1.7A13 13 0 1 0 16 3zm0 23.7a10.7 10.7 0 0 1-5.5-1.5l-.4-.2-3.9 1 1-3.8-.3-.4A10.7 10.7 0 1 1 16 26.7zm5.9-8c-.3-.2-1.9-.9-2.2-1s-.5-.2-.7.2-.8 1-1 1.2-.4.2-.7 0a8.8 8.8 0 0 1-4.3-3.8c-.3-.6.3-.5 1-1.7a.6.6 0 0 0 0-.6l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6a1.2 1.2 0 0 0-.9.4 3.6 3.6 0 0 0-1.1 2.7 6.3 6.3 0 0 0 1.3 3.3 14.4 14.4 0 0 0 5.5 4.9c2 .9 2.9 1 3.9.8a3.3 3.3 0 0 0 2.2-1.5 2.7 2.7 0 0 0 .2-1.5c-.1-.2-.3-.3-.6-.5z"/></svg>
  </a>
  <% if (path !== '/quote') { %>
  <a class="fab-quote" href="/quote">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
    Get Bulk Quote <span class="badge-count light" data-cart-count hidden>0</span>
  </a>
  <% } %>
</div>
<div class="toast" role="status" aria-live="polite" hidden></div>
<% } %>
<script src="/js/pricing.js"></script>
<script src="/js/app.js"></script>
<% if (locals.scripts) { locals.scripts.forEach((s) => { %><script src="<%= s %>"></script><% }) } %>
</body>
</html>
