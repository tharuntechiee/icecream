<%- include('partials/top') %>
<%
  const diamond = '<div class="rule" aria-hidden="true"><svg viewBox="0 0 12 12"><path d="M6 0l6 6-6 6-6-6z"/></svg></div>';
  const groups = [
    ['Hyderabad', site.serviceZones.filter((z) => z.ring)],
    ['Telangana', site.serviceZones.filter((z) => !z.ring && z.state === 'Telangana')],
    ['Andhra Pradesh', site.serviceZones.filter((z) => z.state === 'Andhra Pradesh')],
  ];
  const outMins = site.serviceZones.filter((z) => !z.ring).map((z) => z.minOrder);
  const mapData = h.mapData();
%>
<link rel="stylesheet" href="/vendor/leaflet/leaflet.css">
<section class="page-head">
  <div class="wrap narrow">
    <h1>Delivery across Telangana &amp; Andhra Pradesh</h1>
    <p>From our cold store in <%= site.city %>, −18°C refrigerated vans cover the city the same or next day, and run scheduled routes to every region of Telangana and Andhra Pradesh.</p>
  </div>
</section>

<section class="wrap" aria-label="Ordering rules">
  <div class="frame menu" style="padding:28px 24px">
    <dl class="speclist" style="max-width:760px;margin:0 auto">
      <dt>Minimum order</dt><dd><%= h.money(site.minOrderValue) %> in <%= site.city %>; <%= h.money(Math.min(...outMins)) %>–<%= h.money(Math.max(...outMins)) %> per drop elsewhere</dd>
      <dt>Advance notice</dt><dd><%= site.advanceNoticeHours %> h in <%= site.city %> (same day in Zone A before 11 AM); 48 h for other regions</dd>
      <dt>Cold chain</dt><dd>−18°C reefer vans with temperature data loggers, dry ice on long routes</dd>
      <dt>Time slots</dt><dd><%= site.timeSlots.join(' · ') %></dd>
    </dl>
  </div>
</section>

<section class="band" aria-labelledby="chk-h">
  <div class="wrap">
    <div class="band-head"><h2 id="chk-h">Check your delivery spot</h2><%- diamond %><p>Search your venue or street, use your current location, or drag the map under the pin. You'll see the delivery zone, time, minimum order and the road distance from our cold store.</p></div>
    <div class="frame lp-frame"><div data-locpicker data-mode="check"></div></div>
    <ul class="map-legend">
      <li><span class="lg-ring"></span>Hyderabad zones A, B and C (approximate rings)</li>
      <li><span class="lg-dot"></span>Towns on our regional reefer routes</li>
      <li><span class="key-mark"></span><%= site.coldStore.name %></li>
    </ul>
  </div>
</section>

<section class="band sunk" aria-labelledby="zones-h">
  <div class="wrap">
    <div class="band-head"><h2 id="zones-h">Regions, times &amp; charges</h2><%- diamond %><p>Select a region to see it on the map.</p></div>
    <% groups.forEach(([title, zones]) => { %>
      <h3 class="state-head"><%= title %></h3>
      <div class="tariff" style="margin-bottom:40px">
        <% zones.forEach((z) => { %>
          <div class="tariff-row" data-zone="<%= z.name %>" data-eta="<%= z.eta %>" data-min="<%= h.money(z.minOrder) %>">
            <h3><button type="button" class="zone-btn" data-zone-focus="<%= z.name %>"><%= z.name.replace(/^Hyderabad /, '').replace(/^(Telangana|Andhra) — /, '') %></button></h3>
            <p class="from" style="font-size:1.15rem"><%= z.eta %></p>
            <div>
              <p class="soft" style="margin:0 0 6px"><%= z.chargeNote %> · minimum <%= h.money(z.minOrder) %></p>
              <ul class="area-list"><% z.areas.forEach((a) => { %><li data-area><%= a %></li><% }) %></ul>
            </div>
          </div>
        <% }) %>
      </div>
    <% }) %>
  </div>
</section>

<section class="band" aria-labelledby="van-h">
  <div class="wrap narrow">
    <div class="band-head"><h2 id="van-h">Our cold-chain vans</h2><%- diamond %></div>
    <ul class="ticks">
      <li>Reefer units holding −18 to −22°C, pre-cooled before loading</li>
      <li>Long routes carry food-grade dry ice as a second line of cold</li>
      <li>Data loggers on every trip, with a temperature report on request</li>
      <li>A live GPS link shared on WhatsApp on the day</li>
      <li>The driver probe-checks the product at handover</li>
    </ul>
  </div>
</section>

<script type="application/json" id="map-data"><%- h.jsonScript(mapData) %></script>
<script src="/vendor/leaflet/leaflet.js"></script>
<script src="/js/locpicker.js"></script>
<%- include('partials/bottom') %>
