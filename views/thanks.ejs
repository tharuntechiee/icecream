<%- include('partials/top') %>
<section class="section">
  <div class="container narrow center">
    <div class="thanks-icon" aria-hidden="true">✓</div>
    <h1>Quote request received</h1>
    <% if (ref) { %><p class="lead">Your reference is <strong><%= ref %></strong></p><% } %>
    <p class="muted">Our order desk will call or WhatsApp you within 2 business hours with confirmed stock, delivery slot and final price. Nothing is charged until you confirm.</p>
    <div class="cta-actions center">
      <a class="btn btn-primary" href="<%= h.waLink(`Hi ${site.brand}, I just sent quote request ${ref || ''}.`) %>" target="_blank" rel="noopener">Follow up on WhatsApp</a>
      <a class="btn btn-secondary" href="/products">Back to catalogue</a>
    </div>
    <p class="small muted">Ordering regularly? <a href="/register">Register a business account</a> for GST invoices and credit terms.</p>
  </div>
</section>
<%- include('partials/bottom') %>
