<%- include('partials/top') %>
<%
  const diamond = '<div class="rule" aria-hidden="true"><svg viewBox="0 0 12 12"><path d="M6 0l6 6-6 6-6-6z"/></svg></div>';
  const temps = ['Our plant', '−35°C', '−22°C', '−18°C', 'Your door'];
%>
<section class="page-head">
  <div class="wrap narrow">
    <h1>Frozen, food-safe and on time since 2012</h1>
    <p>We started with one chest freezer and a borrowed van, delivering kulfi to wedding caterers in <%= site.city %>. Today we run an FSSAI-licensed plant, a −22°C cold store and our own reefer vans, serving restaurants, hotels, caterers, shops and offices every week.</p>
  </div>
</section>

<section class="band sunk" aria-labelledby="cc-h">
  <div class="wrap">
    <div class="band-head"><h2 id="cc-h">The cold chain, step by step</h2><%- diamond %></div>
    <ol class="programme">
      <% content.coldChain.forEach((c, i) => { %><li><span class="when"><%= temps[i] %></span><div><h3><%= c.title %></h3><p><%= c.text %></p></div></li><% }) %>
    </ol>
  </div>
</section>

<section class="band" aria-labelledby="cert-h">
  <div class="wrap">
    <div class="band-head"><h2 id="cert-h">Hygiene &amp; food safety</h2><%- diamond %></div>
    <div class="tariff">
      <div class="tariff-row"><h3>FSSAI licence</h3><p class="from" style="font-size:1.1rem">Lic. No. <%= site.certifications.fssai %></p><p class="soft" style="margin:0">State licence for manufacturing and storing frozen desserts and ice.</p></div>
      <div class="tariff-row"><h3>HACCP plan</h3><p class="from" style="font-size:1.1rem">Audited yearly</p><p class="soft" style="margin:0">Critical control points from pasteurisation to dispatch.</p></div>
      <div class="tariff-row"><h3>Quality lab</h3><p class="from" style="font-size:1.1rem">Every batch</p><p class="soft" style="margin:0">Coliform and TPC tests on every batch; RO water for ice tested daily.</p></div>
    </div>
    <ul class="ticks" style="margin-top:32px;max-width:760px">
      <li>Staff in hairnets, gloves and aprons, with health checks every six months</li>
      <li>Closed, hands-free filling and bagging lines</li>
      <li>24×7 cold-room temperature logging with alarms</li>
      <li>Pest-control contract and monthly sanitation audits</li>
      <li>Batch codes on every carton for full traceability</li>
      <li>Temperature-logged deliveries, probe-checked at handover</li>
    </ul>
  </div>
</section>

<section class="band sunk" aria-labelledby="fac-h">
  <div class="wrap">
    <div class="band-head"><h2 id="fac-h">Inside the facility</h2><%- diamond %><p><span class="illus">Illustrations until facility photos are added</span></p></div>
    <div class="figs">
      <figure class="fig"><span class="line-art" role="img" aria-label="Cold store racks at −22°C" style="--art:url('/art/s/facility.svg?plain=1')"></span><figcaption><strong>−22°C cold store</strong>1,200 pallet positions with backup power</figcaption></figure>
      <figure class="fig"><span class="line-art" role="img" aria-label="Ice block production" style="--art:url('/art/s/block.svg?plain=1')"></span><figcaption><strong>Ice plant</strong>40 tonnes a day from RO-purified water</figcaption></figure>
      <figure class="fig"><span class="line-art" role="img" aria-label="Refrigerated delivery van" style="--art:url('/art/s/van.svg?plain=1')"></span><figcaption><strong>Reefer fleet</strong>GPS-tracked vans with data loggers</figcaption></figure>
    </div>
  </div>
</section>
<%- include('partials/bottom') %>
