<%- include('partials/top') %>
<%
  const first = p.sizes[0];
  const cat = content.categories.find((c) => c.id === p.category);
  const units = (u, n) => n === 1 ? u : (u === 'box' ? 'boxes' : u + 's');
%>
<script type="application/ld+json"><%- h.jsonScript({
  '@context': 'https://schema.org', '@type': 'Product', name: p.name, description: p.description,
  image: site.siteUrl + h.artUrl(p), brand: { '@type': 'Brand', name: site.brand }, category: cat && cat.name,
  offers: { '@type': 'AggregateOffer', priceCurrency: 'INR', lowPrice: h.fromPrice(p), highPrice: Math.max(...p.sizes.map((s) => s.tiers[0].price)), offerCount: p.sizes.length, availability: 'https://schema.org/InStock' },
}) %></script>

<div class="wrap"><nav class="crumbs" aria-label="Breadcrumb"><a href="/products">Catalogue</a> / <a href="/products?category=<%= p.category %>"><%= cat ? cat.name : '' %></a> / <span><%= p.name %></span></nav></div>

<section class="wrap">
  <div class="pdp" data-pdp data-product="<%= p.id %>">
    <div class="frame label-card">
      <div class="rule" aria-hidden="true"><svg viewBox="0 0 12 12"><path d="M6 0l6 6-6 6-6-6z"/></svg></div>
      <h1><%= p.name %></h1>
      <% if (p.flavours.length) { %>
        <div class="swatches" aria-hidden="true"><% p.flavours.forEach((f) => { %><span class="sw" style="background:<%= h.swatch(f) %>" title="<%= f %>"></span><% }) %></div>
        <p class="flav"><%= p.flavours.join(' · ') %></p>
      <% } %>
      <p class="desc"><%= p.description %></p>
      <% if (p.dietary.length || p.seasonal || p.category === 'custom') { %>
        <p class="flav small"><%= [...p.dietary.map((d) => content.dietary[d]), p.seasonal ? 'Seasonal' : '', p.category === 'custom' ? 'Made to order' : ''].filter(Boolean).join(' · ') %></p>
      <% } %>
      <% if (p.highlights && p.highlights.length) { %><ul class="ticks"><% p.highlights.forEach((x) => { %><li><%= x %></li><% }) %></ul><% } %>
      <div class="label-figure"><span class="line-art" aria-hidden="true" style="--art:url('<%= h.artUrl(p, 'plain') %>')"></span>
        <% if (p.category !== 'ice' && p.category !== 'addons') { %><p class="photo-note"><span class="illus">Product photography to come</span></p><% } %></div>
    </div>

    <div class="frame order" id="order">
      <fieldset class="sizes">
        <legend class="label">Pack size</legend>
        <% p.sizes.forEach((s, i) => { %>
          <label class="size-opt"><input type="radio" name="size" value="<%= s.id %>" <%= i === 0 ? 'checked' : '' %>><span><b><%= s.label %></b><small><%= s.contains %></small></span></label>
        <% }) %>
      </fieldset>

      <% if (p.flavours.length) { %>
      <div class="field-row"><label class="label" for="p-fl">Flavour</label>
        <select id="p-fl" data-flavour>
          <% if (p.flavours.length > 1) { %><option value="Assorted">Assorted, split in notes</option><% } %>
          <% p.flavours.forEach((f) => { %><option><%= f %></option><% }) %>
        </select></div>
      <% } %>

      <table class="rates" data-tier-table>
        <thead><tr><th>Quantity</th><th>Rate, before GST</th></tr></thead>
        <tbody>
          <% h.Pricing.tierRanges(first).forEach((t, i) => { %><tr class="<%= i === 0 ? 'on' : '' %>"><td><%= t.label %> <%= units(first.unit, 2) %></td><td><%= h.money(t.price) %></td></tr><% }) %>
        </tbody>
      </table>

      <div class="qty-row">
        <span class="label">Order <span data-unit><%= units(first.unit, 2) %></span></span>
        <div class="stepper" data-stepper>
          <button type="button" data-step="-1" aria-label="Fewer">−</button>
          <input type="number" inputmode="numeric" min="<%= first.moq %>" value="<%= first.moq %>" data-qty aria-label="Quantity">
          <button type="button" data-step="1" aria-label="More">+</button>
        </div>
      </div>
      <p class="small" data-moq-note style="color:var(--warn);margin:0"></p>

      <div class="sum">
        <div><p class="label" style="margin:0 0 6px">Estimate</p><span class="big tabular" data-estimate><%= h.money(first.tiers[0].price * first.moq) %></span></div>
        <span class="small soft" data-estimate-note><%= h.money(first.tiers[0].price) %> per <%= first.unit %></span>
      </div>
      <button class="btn btn-verm" type="button" data-pdp-add>Add to cart <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg></button>
      <p class="small mute center" style="margin:-8px 0 0">No payment now. We confirm the price and delivery first.</p>

      <dl class="speclist">
        <dt>Contents</dt><dd data-spec-contains><%= first.contains %></dd>
        <dt>Units per <span data-unit-one><%= first.unit %></span></dt><dd data-spec-units><%= first.unitsPerCarton %></dd>
        <dt>Minimum order</dt><dd data-spec-moq><%= first.moq %> <%= units(first.unit, first.moq) %></dd>
        <dt>Shelf life</dt><dd><%= p.shelfLife %></dd>
        <dt>Storage</dt><dd><%= p.storageTemp %></dd>
        <dt>Lead time</dt><dd><%= p.leadTime %></dd>
      </dl>
    </div>
  </div>
</section>

<% if (related.length) { %>
<section class="band" aria-labelledby="rel-h">
  <div class="wrap">
    <div class="band-head"><h2 id="rel-h">Often ordered with it</h2></div>
    <div class="places"><% related.forEach((r) => { %><%- include('partials/card', { p: r }) %><% }) %></div>
  </div>
</section>
<% } %>

<script type="application/json" id="catalog"><%- h.jsonScript(catalog) %></script>
<%- include('partials/bottom') %>
