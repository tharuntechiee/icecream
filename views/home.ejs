<%- include('partials/top') %>

<section class="hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">Wholesale · <%= site.city %> & nearby</p>
      <h1>Bulk Ice Cream &amp; Ice Supply for Every Occasion</h1>
      <p class="lead">Tubs, cups, kulfi, logo-printed packs, ice blocks and dry ice — by the carton, for restaurants, hotels, caterers, weddings, shops and offices. Delivered frozen at −18°C.</p>

      <form class="search-pill" action="/products" method="get" role="search" aria-label="Find products">
        <label class="seg">
          <span class="seg-label">What</span>
          <select name="category" aria-label="Category">
            <option value="">All products</option>
            <% content.categories.forEach((c) => { %><option value="<%= c.id %>"><%= c.name %></option><% }) %>
          </select>
        </label>
        <label class="seg">
          <span class="seg-label">Dietary</span>
          <select name="diet" aria-label="Dietary">
            <option value="">Any</option>
            <% Object.entries(content.dietary).forEach(([k, v]) => { %><option value="<%= k %>"><%= v %></option><% }) %>
          </select>
        </label>
        <button class="search-orb" type="submit" aria-label="Search catalogue">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
        </button>
      </form>

      <div class="hero-ctas">
        <a class="btn btn-primary" href="/quote">Request a bulk quote</a>
        <a class="btn btn-secondary" href="/events#calculator">Calculate for my event</a>
      </div>
    </div>
    <div class="hero-art" aria-hidden="true">
      <img src="/art/s/tub.svg?c=F4A3B4&l=4L" alt="" class="ha ha1" width="400" height="300">
      <img src="/art/s/cup.svg?c=FFB627&l=100ml" alt="" class="ha ha2" width="400" height="300">
      <img src="/art/s/block.svg" alt="" class="ha ha3" width="400" height="300">
      <img src="/art/s/branded.svg?c=F7B2C4&l=YOUR" alt="" class="ha ha4" width="400" height="300">
    </div>
  </div>
</section>

<section class="stats-band" aria-label="Our numbers">
  <div class="container stats">
    <% site.stats.forEach((s) => { %>
      <div class="stat"><strong><%= s.value %></strong><span><%= s.label %></span></div>
    <% }) %>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-head">
      <h2>Shop by category</h2>
      <a class="link-more" href="/products">View full catalogue →</a>
    </div>
    <div class="grid grid-4">
      <% content.categories.forEach((c) => { %>
        <a class="category-card" href="/products?category=<%= c.id %>">
          <div class="card-photo"><img src="<%= h.shapeUrl(c.art) %>" alt="" loading="lazy" width="400" height="300"></div>
          <h3><%= c.name %></h3>
          <p class="muted small"><%= c.blurb %></p>
          <p class="small"><strong><%= counts[c.id] %></strong> product lines</p>
        </a>
      <% }) %>
    </div>
  </div>
</section>

<section class="section section-soft">
  <div class="container">
    <div class="section-head center">
      <h2>How it works</h2>
      <p class="muted">No online payment, no surprises — a real person confirms every order.</p>
    </div>
    <ol class="steps">
      <% content.steps.forEach((s, i) => { %>
        <li class="step">
          <span class="step-num"><%= i + 1 %></span>
          <h3><%= s.title %></h3>
          <p class="muted"><%= s.text %></p>
        </li>
      <% }) %>
    </ol>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-head">
      <h2>Bestsellers for bulk buyers</h2>
      <a class="link-more" href="/products">See all →</a>
    </div>
    <div class="grid grid-cards">
      <% featured.forEach((p) => { %><%- include('partials/card', { p }) %><% }) %>
    </div>
  </div>
</section>

<section class="section section-soft">
  <div class="container">
    <p class="eyebrow center">Trusted by <%= site.city %>’s kitchens, venues and stores</p>
    <ul class="logo-wall">
      <% content.clients.forEach((c) => { %><li><%= c %></li><% }) %>
    </ul>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-head"><h2>What our clients say</h2></div>
    <div class="grid grid-3">
      <% content.testimonials.forEach((t) => { %>
        <figure class="testimonial">
          <div class="stars" aria-label="5 out of 5">★★★★★</div>
          <blockquote>“<%= t.quote %>”</blockquote>
          <figcaption><strong><%= t.name %></strong><span class="muted small"><%= t.role %></span></figcaption>
        </figure>
      <% }) %>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="cta-band">
      <div>
        <h2>Planning an event or restocking your freezer?</h2>
        <p>Send us your list — we reply with stock, delivery slot and a final price within 2 business hours.</p>
      </div>
      <div class="cta-actions">
        <a class="btn btn-light" href="/quote">Request a quote</a>
        <a class="btn btn-ghost-light" href="<%= h.waLink(`Hi ${site.brand}, I need a bulk quote.`) %>" target="_blank" rel="noopener">WhatsApp us</a>
      </div>
    </div>
  </div>
</section>

<%- include('partials/bottom') %>
