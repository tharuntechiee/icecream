<%- include('partials/top') %>
<%
  const diamond = '<div class="rule" aria-hidden="true"><svg viewBox="0 0 12 12"><path d="M6 0l6 6-6 6-6-6z"/></svg></div>';
  const inviteEvents = ['Wedding', 'Birthday / private party', 'Corporate event', 'Festival / puja', 'Restaurant / café restock'];
  const catLines = {
    'ice-cream': ['Tubs · 1L, 4L, 5L', 'Cups · 100 & 125ml', 'Malai & matka kulfi', 'Cones, sticks, sundaes', 'Sugar-free & vegan'],
    custom: ['Logo-printed cups', 'Private-label tubs', 'Wedding name sleeves', 'Corporate gift boxes'],
    ice: ['Blocks · 5 to 50 kg', 'Bagged party cubes', 'Crushed ice', 'Food-grade dry ice'],
    addons: ['Chest freezer rental', 'Staffed serving counter', 'Insulated express drop', 'Scoops & cups kits'],
  };
  const catTitle = { 'ice-cream': 'Ice creams', custom: 'Custom packs', ice: 'Ice', addons: 'At the venue' };
  const pkgName = { wedding: 'Weddings', birthday: 'Birthdays', corporate: 'Corporate', festival: 'Festivals' };
  const pkgCta = { wedding: 'Size my wedding', birthday: 'Size my party', corporate: 'Size my event', festival: 'Size my festival' };
  const when = ['Today', 'Within 2 business hours', 'On the day'];
  const [lead, ...more] = content.testimonials;
%>

<section class="invite-wrap">
  <div class="wrap narrow">
    <form class="invite frame" data-invite action="/quote" method="get" novalidate>
      <span class="corner tl" aria-hidden="true"></span><span class="corner tr" aria-hidden="true"></span><span class="corner bl" aria-hidden="true"></span><span class="corner br" aria-hidden="true"></span>
      <h1>Bulk ice cream &amp; ice<br><em>for every occasion</em></h1>
      <p class="lede">Write your event on this card. We size the order, then deliver it at −18°C across Telangana and Andhra Pradesh, with freezers and servers at the venue. A person confirms every quote on WhatsApp.</p>
      <div class="fields">
        <div class="fld"><label class="label" for="i-ev">Event</label>
          <select id="i-ev" name="event"><% inviteEvents.forEach((e) => { %><option><%= e %></option><% }) %></select></div>
        <div class="fld"><label class="label" for="i-date">Date</label>
          <div class="datewrap"><span class="dateface" data-date-face aria-hidden="true">Choose a date</span><input id="i-date" name="date" type="date"></div></div>
        <div class="fld"><label class="label" for="i-venue">Venue</label>
          <select id="i-venue" name="venue">
            <% site.serviceZones.forEach((z) => { %><optgroup label="<%= z.name %>"><% z.areas.forEach((a) => { %><option<%= a === 'Gachibowli' ? ' selected' : '' %>><%= a %></option><% }) %></optgroup><% }) %>
            <option>Other area</option>
          </select></div>
        <div class="fld"><label class="label" for="i-g">Guests</label><input id="i-g" name="guests" type="number" min="1" max="100000" inputmode="numeric" value="600"></div>
      </div>
      <div class="estimate" aria-live="polite"><span class="big tabular" data-est-big>Add your guest count</span><span class="mute" data-est-line>We size the order for you.</span></div>
      <div class="invite-actions">
        <button class="btn btn-verm" type="submit">Request the quote <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button>
        <a class="btn btn-foil" href="<%= h.waLink(`Hi ${site.brand}, I'd like a bulk quote.`) %>" target="_blank" rel="noopener" data-wa-card>Send this card on WhatsApp</a>
      </div>
    </form>
  </div>
</section>

<section class="band sunk" aria-labelledby="prog-h">
  <div class="wrap">
    <div class="band-head"><h2 id="prog-h">How an order unfolds</h2><%- diamond %></div>
    <ol class="programme">
      <% content.steps.forEach((s, i) => { %>
        <li><span class="when"><%= when[i] %></span><div><h3><%= s.title === 'Get quote' ? 'Get the quote' : s.title %></h3><p><%= s.text %></p></div></li>
      <% }) %>
    </ol>
  </div>
</section>

<section class="band" aria-labelledby="menu-h">
  <div class="wrap">
    <div class="frame menu">
      <div class="band-head"><h2 id="menu-h">What we bring</h2><%- diamond %></div>
      <div class="menu-cols">
        <% content.categories.forEach((c) => { %>
          <div class="menu-col">
            <h3><a href="/products?category=<%= c.id %>"><%= catTitle[c.id] %></a></h3>
            <ul><% catLines[c.id].forEach((l) => { %><li><%= l %></li><% }) %></ul>
            <a class="go" href="/products?category=<%= c.id %>"><%= counts[c.id] %> product lines</a>
          </div>
        <% }) %>
      </div>
    </div>
  </div>
</section>

<section class="band sunk" aria-labelledby="pk-h">
  <div class="wrap">
    <div class="band-head"><h2 id="pk-h">Packages for the occasion</h2><%- diamond %><p>Indicative per-guest prices for one serving at catalogue tiers, before GST, rentals and delivery.</p></div>
    <div class="tariff">
      <% content.eventPackages.forEach((pk) => { %>
        <div class="tariff-row">
          <h3><%= pkgName[pk.id] %></h3>
          <p class="from">₹<%= pk.from %> <small>per guest, from</small></p>
          <ul><% pk.includes.slice(0, 3).forEach((i) => { %><li><%= i %></li><% }) %></ul>
          <a class="btn btn-foil btn-sm" href="/events#calculator"><%= pkgCta[pk.id] %></a>
        </div>
      <% }) %>
    </div>
  </div>
</section>

<section class="band" aria-labelledby="kw-h">
  <div class="wrap">
    <div class="words">
      <h2 id="kw-h" class="sr-only">Kind words</h2>
      <%- diamond %>
      <blockquote>“<%= lead.quote %>”</blockquote>
      <cite><%= lead.name %> · <%= lead.role %></cite>
      <p style="margin-top:14px"><span class="illus">Illustrative testimonial</span></p>
      <div class="words-more">
        <% more.forEach((t) => { %>
          <figure><blockquote>“<%= t.quote %>”</blockquote><figcaption class="small mute"><%= t.name %> · <%= t.role %> · illustrative</figcaption></figure>
        <% }) %>
      </div>
    </div>
  </div>
</section>

<section class="band sunk">
  <div class="wrap narrow">
    <div class="frame rsvp">
      <h2>Send us the guest list</h2>
      <p class="soft">We reply within two business hours with stock, a delivery slot and the final price.</p>
      <div class="rsvp-actions">
        <a class="btn btn-verm" href="/quote">Open the quote <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
        <a class="btn btn-foil" href="<%= h.waLink(`Hi ${site.brand}, I need a bulk quote.`) %>" target="_blank" rel="noopener">WhatsApp the order desk</a>
      </div>
    </div>
  </div>
</section>

<script type="application/json" id="catalog"><%- h.jsonScript(catalog) %></script>
<script type="application/json" id="serving-formats"><%- h.jsonScript(content.servingFormats) %></script>
<%- include('partials/bottom') %>
