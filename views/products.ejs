<%- include('partials/top') %>
<% const qs = (o) => { const p = new URLSearchParams(); Object.entries(o).forEach(([k, v]) => [].concat(v).forEach((x) => x && p.append(k, x))); const s = p.toString(); return s ? '?' + s : ''; }; %>
<section class="page-head">
  <div class="wrap narrow">
    <nav class="crumbs" aria-label="Breadcrumb" style="padding-top:0;margin-bottom:12px"><a href="/">Home</a> / <% if (cat) { %><a href="/products">Catalogue</a> / <span><%= cat.name %></span><% } else { %><span>Catalogue</span><% } %></nav>
    <h1><%= cat ? cat.name : 'The catalogue' %></h1>
    <p><%= cat ? cat.blurb + '.' : 'Every line shows its pack size, units per carton, minimum order and tier price.' %> <%= site.gstNote %></p>
  </div>
</section>

<section class="wrap" aria-label="Products">
  <nav class="tabs" aria-label="Categories">
    <a class="tab" href="/products" <%- !q.category ? 'aria-current="page"' : '' %>>All</a>
    <% content.categories.forEach((c) => { %><a class="tab" href="/products?category=<%= c.id %>" <%- q.category === c.id ? 'aria-current="page"' : '' %>><%= c.name %></a><% }) %>
  </nav>

  <form class="filters" method="get" action="/products" data-autosubmit>
    <% if (q.category) { %><input type="hidden" name="category" value="<%= q.category %>"><% } %>
    <label class="field"><span class="sr-only">Search</span><input type="search" name="q" value="<%= q.search %>" placeholder="Search kulfi, mango, 50 kg…"></label>
    <% if (options.flavours.length) { %>
    <label class="field"><span class="sr-only">Flavour</span>
      <select name="flavour"><option value="">All flavours</option><% options.flavours.forEach((f) => { %><option <%= q.flavour === f ? 'selected' : '' %>><%= f %></option><% }) %></select></label>
    <% } %>
    <label class="field"><span class="sr-only">Pack size</span>
      <select name="size"><option value="">All pack sizes</option><% options.sizes.forEach((s) => { %><option <%= q.size === s ? 'selected' : '' %>><%= s %></option><% }) %></select></label>
    <div class="diet" role="group" aria-label="Refine">
      <% if (options.hasDietary) { %><span class="label">Dietary</span>
        <% Object.entries(content.dietary).forEach(([k, v]) => { %><label class="chip"><input type="checkbox" name="diet" value="<%= k %>" <%= q.diet.includes(k) ? 'checked' : '' %>><%= v %></label><% }) %>
      <% } %>
      <label class="field" style="margin-left:auto;min-width:200px"><span class="sr-only">Sort</span>
        <select name="sort">
          <option value="popular" <%= q.sort === 'popular' ? 'selected' : '' %>>Most popular first</option>
          <option value="price-asc" <%= q.sort === 'price-asc' ? 'selected' : '' %>>Price: low to high</option>
          <option value="price-desc" <%= q.sort === 'price-desc' ? 'selected' : '' %>>Price: high to low</option>
        </select></label>
      <noscript><button class="btn btn-foil btn-sm" type="submit">Apply</button></noscript>
    </div>
  </form>

  <p class="count"><%= list.length %> product line<%= list.length === 1 ? '' : 's' %> · prices per unit shown, before GST<% if ([q.search, q.flavour, q.size, ...q.diet].some(Boolean)) { %> · <a href="/products<%= qs({ category: q.category }) %>">clear filters</a><% } %></p>

  <% if (list.length) { %>
    <div class="places">
      <% list.forEach((p) => { %><%- include('partials/card', { p }) %><% }) %>
    </div>
  <% } else { %>
    <div class="empty" style="margin-bottom:72px">
      <h2 class="h-sub">Nothing matches those filters</h2>
      <p class="soft">Clear a filter, or tell us what you need on WhatsApp and we will source it.</p>
      <a class="btn btn-foil btn-sm" href="/products<%= qs({ category: q.category }) %>">Clear filters</a>
    </div>
  <% } %>
</section>
<%- include('partials/bottom') %>
