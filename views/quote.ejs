<%- include('partials/top') %>
<section class="page-head">
  <div class="wrap narrow">
    <h1>Your bulk quote</h1>
    <p>Build the order, choose a delivery slot and send it. We confirm stock, the final price and delivery within two business hours. <strong>This is an enquiry; no payment is taken.</strong></p>
  </div>
</section>

<div class="wrap quote-layout" data-quote-page data-min-date="<%= minDate %>" data-mov="<%= site.minOrderValue %>">
  <section aria-labelledby="items-h">
    <div class="section-head" style="border-bottom:1px solid var(--foil);padding-bottom:10px;margin-bottom:0">
      <h2 id="items-h" class="h-sub" style="margin:0">The order <span class="mute small" data-item-count></span></h2>
      <button class="btn-text" type="button" data-repeat-last hidden>Repeat my last order</button>
    </div>
    <div data-quote-items>
      <noscript><p class="notice">Please enable JavaScript to use the quote cart, or call or WhatsApp us your list.</p></noscript>
    </div>
    <div class="quote-empty" data-quote-empty hidden>
      <h3 class="h-sub">Nothing on the card yet</h3>
      <p class="soft">Add products from the catalogue, or let the event calculator size the order for you.</p>
      <div class="rsvp-actions">
        <a class="btn btn-verm" href="/products">Open the catalogue</a>
        <a class="btn btn-foil" href="/events#calculator">Size an event</a>
      </div>
    </div>
    <div class="summary-card" data-summary hidden>
      <div class="sum-row"><span>Estimated subtotal</span><strong class="tabular" data-subtotal>₹0</strong></div>
      <div class="sum-row small mute"><span>GST (18%) and delivery</span><span>Added in the final quote</span></div>
      <p class="notice warn small" data-mov-warning hidden>The minimum order is <%= h.money(site.minOrderValue) %> per delivery. Send it anyway and we will suggest options.</p>
      <p class="notice warn small" data-moq-warning hidden>Some items are below their minimum order quantity.</p>
    </div>
  </section>

  <section aria-labelledby="details-h">
    <form class="frame form-card" data-quote-form novalidate>
      <h2 id="details-h">Delivery &amp; contact</h2>
      <div class="form-errors" data-form-errors role="alert" hidden></div>
      <div class="form-grid">
        <label class="field"><span>Your name *</span><input name="name" autocomplete="name" required maxlength="80"></label>
        <label class="field"><span>Business name</span><input name="company" autocomplete="organization" maxlength="120"></label>
        <label class="field"><span>Phone / WhatsApp *</span><input name="phone" type="tel" autocomplete="tel" required maxlength="20" placeholder="+91"></label>
        <label class="field"><span>Email</span><input name="email" type="email" autocomplete="email" maxlength="120"></label>
        <label class="field"><span>GSTIN <small>for a GST invoice</small></span><input name="gstin" maxlength="15" style="text-transform:uppercase" placeholder="36ABCDE1234F1Z5"></label>
        <label class="field"><span>Event / order type</span>
          <select name="eventType"><option value="">Select…</option><% site.eventTypes.forEach((t) => { %><option <%= preset.eventType === t ? 'selected' : '' %>><%= t %></option><% }) %></select></label>
        <label class="field"><span>Delivery date *</span><input name="deliveryDate" type="date" min="<%= minDate %>" required></label>
        <label class="field"><span>Time slot *</span>
          <select name="timeSlot" required><option value="">Select…</option><% site.timeSlots.forEach((t) => { %><option><%= t %></option><% }) %></select></label>
        <label class="field"><span>Area</span>
          <select name="area">
            <option value="">Select area…</option>
            <% site.serviceZones.forEach((z) => { %><optgroup label="<%= z.name %>"><% z.areas.forEach((a) => { %><option><%= a %></option><% }) %></optgroup><% }) %>
                        <option>Other / not listed</option>
          </select></label>
        <label class="field"><span>Guests <small>for events</small></span><input name="guests" type="number" min="0" inputmode="numeric" value="<%= preset.guests %>"></label>
        <div class="field span-2 pin-row">
          <button class="btn btn-foil btn-sm" type="button" data-map-toggle aria-expanded="false" aria-controls="map-panel"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7-6.1-7-11a7 7 0 0 1 14 0c0 4.9-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>Pick the delivery spot on the map</button>
          <span class="small soft" data-pin-note>Drop a pin so the driver finds the exact gate.</span>
          <div class="map-panel" id="map-panel" data-map-panel hidden><div data-locpicker data-mode="pick"></div></div>
          <input type="hidden" name="lat"><input type="hidden" name="lng">
        </div>
        <label class="field span-2"><span>Delivery address *</span><textarea name="address" rows="2" required maxlength="400" autocomplete="street-address" placeholder="Venue or store, street, landmark, pincode"></textarea></label>
        <label class="field span-2"><span>Notes</span><textarea name="notes" rows="3" maxlength="1500" placeholder="Flavour split, freezer at the venue?, access and parking, invoice details…"></textarea></label>
        <label class="hp" aria-hidden="true">Website <input name="website" tabindex="-1" autocomplete="off"></label>
      </div>
      <button class="btn btn-verm btn-block" type="submit" data-submit>Send the quote request</button>
      <p class="small mute center" style="margin-top:12px">By sending, you agree to be contacted about this order by phone, WhatsApp or email.</p>
    </form>
  </section>
</div>

<script type="application/json" id="catalog"><%- h.jsonScript(catalog) %></script>
<script type="application/json" id="map-data"><%- h.jsonScript({ centre: site.hyderabadCentre, store: site.coldStore, zones: site.serviceZones.map((z) => ({ name: z.name, state: z.state, eta: z.eta, minOrder: z.minOrder, ring: z.ring || null, points: z.points || null })) }) %></script>
<link rel="stylesheet" href="/vendor/leaflet/leaflet.css">
<script src="/vendor/leaflet/leaflet.js"></script>
<script src="/js/locpicker.js"></script>
<%- include('partials/bottom') %>
