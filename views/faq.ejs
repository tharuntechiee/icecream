<%- include('partials/top') %>
<script type="application/ld+json"><%- h.jsonScript({
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: content.faqs.flatMap((g) => g.items.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } }))),
}) %></script>
<section class="page-head">
  <div class="container narrow">
    <h1>Frequently asked questions</h1>
    <p class="muted">Can’t find your answer? <a href="/contact">Contact us</a> or WhatsApp — we reply within minutes during business hours.</p>
    <nav class="chip-row" aria-label="FAQ topics">
      <% content.faqs.forEach((g) => { %><a class="chip" href="#<%= site.slugify(g.topic) %>"><%= g.topic %></a><% }) %>
    </nav>
  </div>
</section>
<div class="container narrow">
  <% content.faqs.forEach((g) => { %>
    <section class="faq-group" id="<%= site.slugify(g.topic) %>">
      <h2><%= g.topic %></h2>
      <% g.items.forEach(([q, a]) => { %>
        <details class="faq">
          <summary><%= q %></summary>
          <p><%= a %></p>
        </details>
      <% }) %>
    </section>
  <% }) %>
</div>
<%- include('partials/bottom') %>
